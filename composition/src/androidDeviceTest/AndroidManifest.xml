<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      The tests build their graphs themselves; MetroX's AppComponentFactory, which needs the app's
      MetroApplication, belongs to `androidApp` and is not in this APK. The integration scenario's
      Compose host runs in the plain ComponentActivity declared below.
    -->
    <application>
        <activity android:name="androidx.activity.ComponentActivity" android:exported="true" />
    </application>
</manifest>
