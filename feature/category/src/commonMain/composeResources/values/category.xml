<resources>
    <!--
      The count and nothing else, the way the browse grid states it.

      This used to read "%1$d tracks • offline". Nothing shipped inside the app: a sound streams
      from Wikimedia the first time it is played and only then downloads into the cache, and the
      download can fail — a 4xx, a size limit, no network. So the claim was false for every sound
      nobody had played yet, which on a first run is all of them. Saying it truthfully would take a
      per-track "is this cached" state the app does not keep and this header could not show anyway.
    -->
    <plurals name="category_track_count">
        <item quantity="one">%1$d track</item>
        <item quantity="other">%1$d tracks</item>
    </plurals>

    <!--
      The same three messages the favorites list shows, because this list holds the same thing.
      Declared per feature rather than shared: the design system draws the line but deliberately
      does not choose the words, which differ for a sound and for a story.
    -->
    <!-- A route outlives the build that wrote it, so a restored back stack can name a category
         the catalog no longer has. -->
    <string name="category_not_found">This category is no longer in the catalog</string>

    <string name="sound_not_found">This sound is no longer in the catalog</string>
    <string name="sound_unavailable">Could not reach this sound. Tap play to try again.</string>
    <string name="sound_could_not_open">Could not play this sound</string>
</resources>
