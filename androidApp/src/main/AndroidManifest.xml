<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:name=".MainApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Xwab">
        <!--
          How this app identifies itself when the player streams a sound that is not cached yet.

          Wikimedia, which every shipped source comes from, asks a client to say who it is and how
          to reach it, and refuses requests that do not. The same string is attached to the download
          requests sound playback sends through delivery — the two have to agree, because they are the same client
          talking to the same host over two different paths.
        -->
        <meta-data
            android:name="com.xwab.app.core.playback.USER_AGENT"
            android:value="SleepSounds/1.0 (https://github.com/SezerUzunca/xwab)" />

        <!--
          Constructed by MetroX's AppComponentFactory, merged in from its manifest, with its
          dependencies; it has no no-argument constructor for lint to find. Metro's own Android
          sample silences the same check the same way.
        -->
        <activity
            android:exported="true"
            android:name=".MainActivity"
            tools:ignore="Instantiatable">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
