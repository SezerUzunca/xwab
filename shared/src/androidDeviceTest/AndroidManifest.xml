<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      The navigation tests host Compose in this plain ComponentActivity. MetroX's AppComponentFactory,
      which needs the app's MetroApplication, belongs to `androidApp` and is not in this APK.
    -->
    <application>
        <activity android:name="androidx.activity.ComponentActivity" android:exported="true" />
    </application>
</manifest>
